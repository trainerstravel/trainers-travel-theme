{% comment %}
  Renders a single event card.
  Usage: {% render 'tt-event-card', col: collection_object, block: block %}

  - Status badge + min price derived from product tags.
  - city: and event-date: product tags populate the meta line.
  - block.settings.event_date / event_city override the meta line when
    no products exist yet (coming soon events).
  - block.settings.status_override forces a specific badge (skips auto-detect).
  - block.settings.hide_after (YYYY-MM-DD) auto-hides the card after that date.
  - Stub blocks (no collection) render from block.settings.title alone.
{% endcomment %}

{%- assign ec_should_render = true -%}

{%- if block != blank and block.settings.hide_after != blank -%}
  {%- assign ec_now_ts = 'now' | date: '%s' | plus: 0 -%}
  {%- assign ec_hide_ts = block.settings.hide_after | date: '%s' | plus: 0 -%}
  {%- if ec_now_ts > ec_hide_ts -%}
    {%- assign ec_should_render = false -%}
  {%- endif -%}
{%- endif -%}

{%- if ec_should_render -%}

{%- assign ec_min_price = nil -%}
{%- assign ec_all_sold_out = true -%}
{%- assign ec_status_tag = '' -%}
{%- assign ec_date_str = '' -%}
{%- assign ec_city_str = '' -%}

{%- for product in col.products limit: 20 -%}
  {%- if product.available -%}{%- assign ec_all_sold_out = false -%}{%- endif -%}
  {%- if ec_min_price == nil or product.price_min < ec_min_price -%}
    {%- assign ec_min_price = product.price_min -%}
  {%- endif -%}
  {%- for tag in product.tags -%}
    {%- if tag == 'status:selling-fast' and ec_status_tag == '' -%}{%- assign ec_status_tag = 'selling-fast' -%}{%- endif -%}
    {%- if tag == 'status:coming-soon' and ec_status_tag == '' -%}{%- assign ec_status_tag = 'coming-soon' -%}{%- endif -%}
    {%- if tag contains 'event-date:' and ec_date_str == '' -%}{%- assign ec_date_str = tag | remove: 'event-date:' -%}{%- endif -%}
    {%- if tag contains 'city:' and ec_city_str == '' -%}{%- assign ec_city_str = tag | remove: 'city:' | capitalize -%}{%- endif -%}
  {%- endfor -%}
{%- endfor -%}

{%- if ec_date_str == '' and block != blank and block.settings.event_date != blank -%}
  {%- assign ec_date_str = block.settings.event_date -%}
{%- endif -%}
{%- if ec_city_str == '' and block != blank and block.settings.event_city != blank -%}
  {%- assign ec_city_str = block.settings.event_city -%}
{%- endif -%}

{%- if col.products_count == 0 -%}
  {%- assign ec_status_tag = 'coming-soon' -%}
{%- elsif ec_all_sold_out -%}
  {%- assign ec_status_tag = 'sold-out' -%}
{%- elsif ec_status_tag == '' -%}
  {%- assign ec_status_tag = 'available' -%}
{%- endif -%}

{%- if block != blank and block.settings.status_override != blank -%}
  {%- assign ec_status_tag = block.settings.status_override -%}
{%- endif -%}

{%- assign ec_title = col.title -%}
{%- assign ec_url = col.url -%}
{%- if col == blank -%}
  {%- assign ec_title = block.settings.title -%}
  {%- assign ec_url = '' -%}
  {%- if ec_status_tag == '' or ec_status_tag == 'available' -%}
    {%- assign ec_status_tag = 'coming-soon' -%}
  {%- endif -%}
{%- endif -%}

{%- assign ec_needs_notify = false -%}
{%- if ec_status_tag == 'coming-soon' or ec_status_tag == 'negotiating' -%}
  {%- assign ec_needs_notify = true -%}
{%- endif -%}

{%- if ec_url != blank -%}
<a href="{{ ec_url }}" class="tt-home__event-card tt-home__event-card--{{ ec_status_tag }}">
{%- else -%}
<div class="tt-home__event-card tt-home__event-card--{{ ec_status_tag }} tt-home__event-card--stub">
{%- endif -%}

  <div class="tt-home__event-card-top">
    <span class="tt-home__event-badge tt-home__event-badge--{{ ec_status_tag }}">
      {%- case ec_status_tag -%}
        {%- when 'sold-out' -%}Sold Out
        {%- when 'selling-fast' -%}Few Rooms Left
        {%- when 'coming-soon' -%}Coming Soon
        {%- when 'negotiating' -%}In Negotiations
        {%- when 'unavailable' -%}Unavailable
        {%- else -%}Now Booking
      {%- endcase -%}
    </span>
  </div>

  <div class="tt-home__event-card-body">
    <p class="tt-home__event-card-title">{{ ec_title }}</p>
    {%- if ec_city_str != '' or ec_date_str != '' -%}
      <p class="tt-home__event-card-meta">
        {%- if ec_city_str != '' -%}{{ ec_city_str }}{%- endif -%}
        {%- if ec_city_str != '' and ec_date_str != '' -%} &middot; {%- endif -%}
        {%- if ec_date_str != '' -%}{{ ec_date_str }}{%- endif -%}
      </p>
    {%- endif -%}
    {%- if col.description != blank -%}
      <p class="tt-home__event-card-desc">{{ col.description | strip_html | truncate: 120 }}</p>
    {%- endif -%}
  </div>

  <div class="tt-home__event-card-footer">
    {%- if ec_min_price != nil and ec_status_tag != 'sold-out' and ec_status_tag != 'coming-soon' and ec_status_tag != 'unavailable' and ec_status_tag != 'negotiating' -%}
      <span class="tt-home__event-card-price">
        From {{ ec_min_price | money }} <span class="tt-home__event-card-price-note">all-in</span>
      </span>
    {%- endif -%}

    {%- if ec_needs_notify and ec_url == blank -%}
      <button
        type="button"
        class="tt-home__event-card-cta tt-home__event-card-notify-btn"
        data-notify-event="{{ ec_title | escape }}"
        data-notify-date="{{ ec_date_str | escape }}"
      >Notify me &rarr;</button>
    {%- elsif ec_status_tag == 'unavailable' -%}
      <span class="tt-home__event-card-cta">More info &rarr;</span>
    {%- elsif ec_needs_notify -%}
      <span class="tt-home__event-card-cta">Notify me &rarr;</span>
    {%- else -%}
      <span class="tt-home__event-card-cta">View rooms &rarr;</span>
    {%- endif -%}
  </div>

{%- if ec_url != blank -%}</a>{%- else -%}</div>{%- endif -%}

{%- endif -%}
