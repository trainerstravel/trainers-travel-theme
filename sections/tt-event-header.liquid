{% comment %}
  Trainers Travel — Event collection header
  File: sections/tt-event-header.liquid

  Used in templates/collection.event.json.
  Status badge logic: auto-detected from products, then overridden by
  section.settings.status_override if set.

  Statuses handled:
    available     — standard booking footer bar
    selling-fast  — standard booking footer bar
    sold-out      — sold out note in footer bar
    coming-soon   — two-column "What's confirmed / What's coming" body
    negotiating   — negotiations-in-progress body
    unavailable   — full statement from collection description, no columns
{% endcomment %}

{{ 'section-tt-event-header.css' | asset_url | stylesheet_tag }}

{%- assign col = collection -%}

{%- comment -%}Derive status and pricing from collection products{%- endcomment -%}
{%- assign eh_min_price = nil -%}
{%- assign eh_all_sold_out = true -%}
{%- assign eh_status_tag = '' -%}
{%- assign eh_date_str = '' -%}
{%- assign eh_city_str = '' -%}

{%- for product in col.products limit: 20 -%}
  {%- if product.available -%}
    {%- assign eh_all_sold_out = false -%}
  {%- endif -%}
  {%- if eh_min_price == nil or product.price_min < eh_min_price -%}
    {%- assign eh_min_price = product.price_min -%}
  {%- endif -%}
  {%- for tag in product.tags -%}
    {%- if tag == 'status:selling-fast' and eh_status_tag == '' -%}
      {%- assign eh_status_tag = 'selling-fast' -%}
    {%- elsif tag == 'status:coming-soon' and eh_status_tag == '' -%}
      {%- assign eh_status_tag = 'coming-soon' -%}
    {%- endif -%}
    {%- if tag contains 'event-date:' and eh_date_str == '' -%}
      {%- assign eh_date_str = tag | remove: 'event-date:' -%}
    {%- endif -%}
    {%- if tag contains 'city:' and eh_city_str == '' -%}
      {%- assign eh_city_str = tag | remove: 'city:' | capitalize -%}
    {%- endif -%}
  {%- endfor -%}
{%- endfor -%}

{%- if col.products_count == 0 -%}
  {%- assign eh_status_tag = 'coming-soon' -%}
{%- elsif eh_all_sold_out -%}
  {%- assign eh_status_tag = 'sold-out' -%}
{%- elsif eh_status_tag == '' -%}
  {%- assign eh_status_tag = 'available' -%}
{%- endif -%}

{%- comment -%}Section setting override takes final priority{%- endcomment -%}
{%- if section.settings.status_override != blank -%}
  {%- assign eh_status_tag = section.settings.status_override -%}
{%- endif -%}

{%- comment -%}Hide the Dawn product grid when there's nothing to show{%- endcomment -%}
{%- if col.products_count == 0 or eh_status_tag == 'unavailable' or eh_status_tag == 'negotiating' -%}
  <style>.shopify-section-{{ section.id }} ~ .shopify-section { display: none !important; }</style>
{%- endif -%}

<div class="tt-eh">
  <div class="tt-eh__inner">

    <div class="tt-eh__top">
      <a href="/" class="tt-eh__back">&larr; All events</a>
      <span class="tt-eh__badge tt-eh__badge--{{ eh_status_tag }}">
        {%- case eh_status_tag -%}
          {%- when 'sold-out' -%}Sold Out
          {%- when 'selling-fast' -%}Few Rooms Left
          {%- when 'coming-soon' -%}Coming Soon
          {%- when 'negotiating' -%}In Negotiations
          {%- when 'unavailable' -%}Unavailable
          {%- else -%}Now Booking
        {%- endcase -%}
      </span>
    </div>

    <h1 class="tt-eh__title">{{ col.title }}</h1>

    {%- if eh_city_str != '' or eh_date_str != '' -%}
      <p class="tt-eh__meta">
        {%- if eh_city_str != '' -%}{{ eh_city_str }}{%- endif -%}
        {%- if eh_city_str != '' and eh_date_str != '' -%} &middot; {%- endif -%}
        {%- if eh_date_str != '' -%}{{ eh_date_str }}{%- endif -%}
      </p>
    {%- endif -%}

    {%- comment -%}═══ UNAVAILABLE — full statement, description only ═══{%- endcomment -%}
    {%- if eh_status_tag == 'unavailable' -%}

      {%- if col.description != blank -%}
        <div class="tt-eh__description tt-eh__description--statement">
          {{ col.description }}
        </div>
      {%- endif -%}
      <div class="tt-eh__cs-cta">
        <p>Questions? Reach out directly.</p>
        <a href="mailto:{{ section.settings.notify_email | default: 'contact@trainerstravel.com' }}" class="tt-eh__cs-btn">
          {{ section.settings.notify_email | default: 'contact@trainerstravel.com' }}
        </a>
      </div>

    {%- comment -%}═══ NEGOTIATING — active negotiations body ═══{%- endcomment -%}
    {%- elsif eh_status_tag == 'negotiating' -%}

      {%- if col.description != blank -%}
        <div class="tt-eh__description">
          {{ col.description }}
        </div>
      {%- endif -%}
      <div class="tt-eh__coming-soon-body">
        <div class="tt-eh__cs-grid">
          <div class="tt-eh__cs-col">
            <p class="tt-eh__cs-label">What&rsquo;s confirmed</p>
            <ul class="tt-eh__cs-list">
              {%- if eh_date_str != '' -%}<li>{{ eh_date_str }}</li>{%- endif -%}
              {%- if eh_city_str != '' -%}<li>{{ eh_city_str }}</li>{%- endif -%}
              <li>We are actively negotiating hotel blocks</li>
            </ul>
          </div>
          <div class="tt-eh__cs-col">
            <p class="tt-eh__cs-label">What&rsquo;s coming</p>
            <ul class="tt-eh__cs-list">
              <li>Group hotel block outside the competition clause window</li>
              <li>All-in pricing &mdash; taxes and fees included</li>
              <li>Venue-proximity selection</li>
              <li>We&rsquo;ll share news as it develops</li>
            </ul>
          </div>
        </div>
        <div class="tt-eh__cs-cta">
          <p>Follow us for updates or reach out directly.</p>
          <a href="mailto:{{ section.settings.notify_email | default: 'contact@trainerstravel.com' }}" class="tt-eh__cs-btn">
            {{ section.settings.notify_email | default: 'contact@trainerstravel.com' }}
          </a>
        </div>
      </div>

    {%- comment -%}═══ COMING SOON — standard two-column preview ═══{%- endcomment -%}
    {%- elsif eh_status_tag == 'coming-soon' -%}

      {%- if col.description != blank -%}
        <div class="tt-eh__description">{{ col.description }}</div>
      {%- endif -%}
      <div class="tt-eh__coming-soon-body">
        <div class="tt-eh__cs-grid">
          <div class="tt-eh__cs-col">
            <p class="tt-eh__cs-label">What&rsquo;s confirmed</p>
            <ul class="tt-eh__cs-list">
              {%- if eh_date_str != '' -%}<li>{{ eh_date_str }}</li>{%- endif -%}
              {%- if eh_city_str != '' -%}<li>{{ eh_city_str }}</li>{%- endif -%}
              {%- if col.description != blank -%}
                <li>{{ col.description | strip_html | truncate: 120 }}</li>
              {%- endif -%}
            </ul>
          </div>
          <div class="tt-eh__cs-col">
            <p class="tt-eh__cs-label">What&rsquo;s coming</p>
            <ul class="tt-eh__cs-list">
              <li>Group hotel block at a negotiated rate</li>
              <li>All-in pricing &mdash; taxes and fees included</li>
              <li>Venue-proximity selection</li>
              <li>One-click booking, no loyalty account needed</li>
            </ul>
          </div>
        </div>
        <div class="tt-eh__cs-cta">
          <p>We&rsquo;ll announce when rooms open. Follow us or reach out directly.</p>
          <a href="mailto:{{ section.settings.notify_email | default: 'contact@trainerstravel.com' }}" class="tt-eh__cs-btn">
            {{ section.settings.notify_email | default: 'contact@trainerstravel.com' }}
          </a>
        </div>
      </div>

    {%- comment -%}═══ AVAILABLE / SELLING FAST / SOLD OUT — pricing footer ═══{%- endcomment -%}
    {%- else -%}

      {%- if col.description != blank -%}
        <div class="tt-eh__description">{{ col.description }}</div>
      {%- endif -%}
      <div class="tt-eh__footer-bar">
        {%- if eh_min_price != nil -%}
          <p class="tt-eh__pricing-note">
            {%- if eh_status_tag == 'sold-out' -%}
              All rooms sold out.
            {%- else -%}
              From <strong>{{ eh_min_price | money }}</strong> &mdash; all taxes &amp; fees included.
            {%- endif -%}
          </p>
        {%- endif -%}
        <p class="tt-eh__rooms-count">{{ col.products_count }} room type{%- if col.products_count != 1 -%}s{%- endif -%} available</p>
      </div>

    {%- endif -%}

  </div>
</div>

{% schema %}
{
  "name": "Event Header",
  "tag": "div",
  "class": "section",
  "limit": 1,
  "settings": [
    {
      "type": "select",
      "id": "status_override",
      "label": "Status override",
      "info": "Force a specific badge. Leave blank to auto-detect from products.",
      "options": [
        { "value": "", "label": "Auto-detect" },
        { "value": "available", "label": "Now Booking" },
        { "value": "selling-fast", "label": "Few Rooms Left" },
        { "value": "coming-soon", "label": "Coming Soon" },
        { "value": "negotiating", "label": "In Negotiations" },
        { "value": "unavailable", "label": "Unavailable" },
        { "value": "sold-out", "label": "Sold Out" }
      ],
      "default": ""
    },
    {
      "type": "text",
      "id": "notify_email",
      "label": "Contact email",
      "default": "contact@trainerstravel.com"
    }
  ]
}
{% endschema %}
